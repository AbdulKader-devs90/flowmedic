# Anthropic API key for the strong role.
ANTHROPIC_API_KEY=
# Claude model for triage synthesis and planning.
ANTHROPIC_MODEL=claude-opus-5-5
# Nebius Token Factory API key for the fast role.
NEBIUS_API_KEY=
# OpenAI-compatible endpoint from the Nebius Token Factory console.
NEBIUS_BASE_URL=
# Model identifier from the Nebius Token Factory console.
NEBIUS_MODEL=
# OpenAI API key for the alternate role.
OPENAI_API_KEY=
# OpenAI model identifier for fallback and comparison.
OPENAI_MODEL=
# Tavily API key for later vendor-document research.
TAVILY_API_KEY=
# Pinecone API key for the later knowledge index.
PINECONE_API_KEY=
# Shared knowledge index name.
PINECONE_INDEX=flowmedic-kb
# Vector backend: pinecone or chroma.
VECTOR_BACKEND=pinecone
# Enable LangSmith tracing when its API key is configured.
LANGSMITH_TRACING=true
# LangSmith API key for trace uploads.
LANGSMITH_API_KEY=
# LangSmith project receiving development traces.
LANGSMITH_PROJECT=flowmedic-dev
# LangSmith API endpoint.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Agent version attached to traces.
AGENT_VERSION=0.1.0
