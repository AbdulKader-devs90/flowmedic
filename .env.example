# Each role selects nebius, anthropic or openai independently.
FAST_PROVIDER=nebius
STRONG_PROVIDER=nebius
ALT_PROVIDER=anthropic
# Optional per-role model overrides; empty uses the selected provider's model.
FAST_MODEL=
STRONG_MODEL=
ALT_MODEL=
# To run every role on Nebius, set ALT_PROVIDER=nebius too.
# Provider credentials are shared by roles choosing the same provider.
# Anthropic API key.
ANTHROPIC_API_KEY=
# Anthropic model used when a role selects anthropic.
ANTHROPIC_MODEL=claude-opus-5-5
# Nebius Token Factory API key.
NEBIUS_API_KEY=
# OpenAI-compatible endpoint from the Nebius Token Factory console.
NEBIUS_BASE_URL=
# Model identifier from the Nebius Token Factory console.
NEBIUS_MODEL=
# OpenAI API key.
OPENAI_API_KEY=
# OpenAI model used when a role selects openai.
OPENAI_MODEL=
# Tavily API key for vendor-document research.
TAVILY_API_KEY=
# Pinecone API key for the later knowledge index.
PINECONE_API_KEY=
# Shared knowledge index name.
PINECONE_INDEX=flowmedic-kb
# Vector backend: pinecone or chroma.
VECTOR_BACKEND=pinecone
# Enable LangSmith tracing when its API key is configured.
LANGSMITH_TRACING=true
# LangSmith API key for trace uploads.
LANGSMITH_API_KEY=
# LangSmith project receiving development traces.
LANGSMITH_PROJECT=flowmedic-dev
# LangSmith API endpoint.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Agent version attached to traces.
AGENT_VERSION=0.1.0
# Pinecone hosted embedding model and serverless deployment.
EMBED_MODEL=multilingual-e5-large
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Local persistent folder (must be inside the repository).
CHROMA_PATH=chroma_data
# Cosine calibration for multilingual-e5-large (retune for other models).
VEC_FLOOR=0.80
VEC_CEIL=0.86
# Hybrid retrieval weights (must sum to 1) and routing thresholds.
KB_VECTOR_WEIGHT=0.6
KB_SIGNATURE_WEIGHT=0.4
KB_KNOWN_FIX=0.60
KB_SIMILAR=0.40

# Step 3: explicit additional read-only log roots (JSON list of local folders).
LOG_ROOTS=[]
LOG_TRANSPORT=stdio
MAX_LLM_CALLS=25
RETRY_BACKOFF=0.25
